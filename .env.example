# Copy this file to .env and fill in actual values. Never commit the real .env file.

# Backend API base URL
# Local dev:
VITE_API_BASE_URL=http://localhost:8000
# Deployed (Render) — replace once backend is deployed:
# VITE_API_BASE_URL=https://TBD.onrender.com

# Add any other keys here as they come up (e.g. if Mistral API is wired up as a stretch goal)
# MISTRAL_API_KEY=
